# llama-server settings. Installed as /etc/llm/llama-server.env.
# No secrets here. The API key is in /etc/llm/api-key.

# Full path to the GGUF file (step 7 of setup.md)
LLM_MODEL=/opt/llm/models/REPLACE_WITH_FILE.gguf

# Name clients send as "model"
LLM_ALIAS=gemma-4-26b-a4b-q4

# Listen on all interfaces. ufw limits access to the web VM.
LLM_HOST=0.0.0.0
LLM_PORT=8080

# Parallel slots, matching N5 (2 to 3 users). Proposed.
LLM_PARALLEL=3

# Total context, shared by the slots: 3 x 8192. Proposed, tune after Phase 0.
LLM_CTX=24576

# One thread per vCPU. vCPUs should map to physical cores.
LLM_THREADS=16
